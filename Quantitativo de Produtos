# PASSO 4: FUNÇÃO DE PROCESSAMENTO (Inalterada)
# ----------------------------------------------------------------------------------
def process_data(df: pd.DataFrame, product_col: str, qty_col: str) -> pd.DataFrame:
    aggregated_data, unmapped_items = {}, []
    sorted_map_keys = sorted(PRODUCT_CONVERSION_MAP.keys(), key=len, reverse=True)
    for _, row in df.iterrows():
        original_name, quantity = row.get(product_col), parse_number(row.get(qty_col, 0))
        if not original_name or quantity == 0: continue
        normalized_name, found_match = normalize_text(original_name), False
        for map_key in sorted_map_keys:
            if map_key in normalized_name:
                target_name, unit, factor = PRODUCT_CONVERSION_MAP[map_key]
                converted_qty = quantity * factor
                if target_name in aggregated_data: aggregated_data[target_name]["quantity"] += converted_qty
                else: aggregated_data[target_name] = {"quantity": converted_qty, "unit": unit}
                found_match = True
                break
        if not found_match: unmapped_items.append({"Produto": str(original_name), "Quantidade": quantity})
    output_rows = []; total_kg, total_l, total_un = 0, 0, 0
    header_items = ["kg", "PÓS E SÓLIDOS", "litros", "LÍQUIDOS", "unidade", "KIT TESTE E REAGENTES"]
    for item_name in DESIRED_SEQUENCE:
        if item_name.startswith("Total"):
            if "KG" in item_name: output_rows.append({"Produto": item_name, "Quantidade": total_kg, "Unidade": "kg"})
            elif "L" in item_name: output_rows.append({"Produto": item_name, "Quantidade": total_l, "Unidade": "L"})
            elif "UN" in item_name: output_rows.append({"Produto": item_name, "Quantidade": total_un, "Unidade": "un"})
        elif item_name in header_items: output_rows.append({"Produto": item_name, "Quantidade": "", "Unidade": ""})
        else:
            data = aggregated_data.get(item_name)
            if data:
                qty, unit = data["quantity"], data["unit"]
                output_rows.append({"Produto": item_name, "Quantidade": qty, "Unidade": unit})
                if unit == "kg": total_kg += qty
                elif unit == "L": total_l += qty
                elif unit == "un": total_un += qty
            else: output_rows.append({"Produto": item_name, "Quantidade": 0, "Unidade": ""})
    if unmapped_items:
        output_rows.append({"Produto": "ITENS NÃO MAPEADOS (VERIFICAR)", "Quantidade": "", "Unidade": ""})
        for item in unmapped_items: output_rows.append({"Produto": item["Produto"], "Quantidade": item["Quantidade"], "Unidade": "original"})
    return pd.DataFrame(output_rows)

