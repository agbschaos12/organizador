        self.btn_process = ctk.CTkButton(top_frame, text="2. Processar Dados", command=self.process_and_show, state="disabled"); self.btn_process.pack(side="left", padx=5)
        self.btn_save = ctk.CTkButton(top_frame, text="3. Exportar Resultado", command=self.save_file, state="disabled"); self.btn_save.pack(side="left", padx=5)
        self.lbl_status = ctk.CTkLabel(top_frame, text="Bem-vindo! Importe a planilha de giro de estoque.", text_color="gray"); self.lbl_status.pack(side="right", padx=10)
        mid_frame = ctk.CTkFrame(self.root); mid_frame.pack(expand=True, fill="both", padx=10, pady=0)
        cols = ("produto", "quantidade", "unidade"); self.tree = ttk.Treeview(mid_frame, columns=cols, show="headings")
        self.tree.heading("produto", text="Produto Final"); self.tree.heading("quantidade", text="Quantidade Convertida"); self.tree.heading("unidade", text="Unidade")
        self.tree.column("produto", width=400, anchor="w"); self.tree.column("quantidade", width=150, anchor="center"); self.tree.column("unidade", width=100, anchor="center")
        vsb = ctk.CTkScrollbar(mid_frame, command=self.tree.yview); self.tree.configure(yscrollcommand=vsb.set)
        self.tree.pack(side="left", fill="both", expand=True, pady=5); vsb.pack(side="right", fill="y", pady=5)

    def import_file(self):
        filetypes = [("Planilhas", "*.xlsx *.xls *.csv")]; path = filedialog.askopenfilename(title="Selecione a planilha", filetypes=filetypes)
        if not path: return
        try:
            df = None
            if path.endswith(('.xls', '.xlsx')): df = pd.read_excel(path)
            elif path.endswith('.csv'):
                encodings_to_try = ['utf-8', 'latin-1', 'cp1252', 'iso-8859-1']
                for encoding in encodings_to_try:
                    try:
                        df = pd.read_csv(path, encoding=encoding, sep=None, engine='python')
                        break
                    except UnicodeDecodeError: continue
            if df is None: raise ValueError("Não foi possível ler o arquivo.")
            self.df_original = df; self.filepath = path
            self.lbl_status.configure(text=f"Arquivo: {os.path.basename(path)}")
            self.btn_process.configure(state="normal"); self.btn_save.configure(state="disabled")
            messagebox.showinfo("Sucesso", f"{len(self.df_original)} linhas carregadas.\nPronto para processar.")
            for i in self.tree.get_children(): self.tree.delete(i)
        except Exception as e: messagebox.showerror("Erro de Importação", f"Não foi possível ler o arquivo.\n\nDetalhes: {e}")

    def detect_columns(self, df: pd.DataFrame):
        product_col, qty_col = None, None
        for col in df.columns:
            c = normalize_text(col)
            if any(k in c for k in ["produto", "servico", "nome", "descricao", "item"]):
                if not product_col: product_col = col
            if any(k in c for k in ["saida"]):
                if not qty_col: qty_col = col
        if not product_col or not qty_col: raise ValueError("Colunas 'Produto' e 'Saída' não detectadas.")
        return product_col, qty_col

    def process_and_show(self):
        if self.df_original is None: return
        try:
            prod_col, qty_col = self.detect_columns(self.df_original)
            self.df_final = process_data(self.df_original, prod_col, qty_col)
            for i in self.tree.get_children(): self.tree.delete(i)
            for _, r in self.df_final.iterrows():
                qty_val = r["Quantidade"]
                qty_str = f"{float(qty_val):.2f}" if isinstance(qty_val, (int, float)) else str(qty_val)
                self.tree.insert("", "end", values=(r["Produto"], qty_str, r["Unidade"]))
            self.btn_save.configure(state="normal")
            messagebox.showinfo("Concluído", "Dados processados com sucesso!")
        except Exception as e: messagebox.showerror("Erro no Processamento", f"Ocorreu um erro.\nDetalhes: {e}")

    def save_file(self):
        if self.df_final is None: return
        initial_name = Path(self.filepath).stem + "_resultado.xlsx"
        path = filedialog.asksaveasfilename(defaultextension=".xlsx", filetypes=[("Planilha Excel", "*.xlsx")], initialfile=initial_name)
        if not path: return
        try:
            self.df_final.to_excel(path, index=False)
            messagebox.showinfo("Sucesso", f"Arquivo salvo em:\n{path}")
        except Exception as e: messagebox.showerror("Erro ao Salvar", f"Não foi possível salvar o arquivo.\nErro: {e}")

